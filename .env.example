# LLM Provider
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Rate Limiting (in-memory stub used if unset)
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_SEC=60

# Upstash Redis (wire up in src/lib/rate-limit/ for production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Eval harness — protect /api/eval and npm run eval
EVAL_SECRET=change_me_to_a_random_string
